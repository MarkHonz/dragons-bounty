// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  password           String
  email              String              @unique
  emailVerified      Boolean             @default(false)
  role               String              @default("USER") // This is a string attribute with a default value
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            Profile? // This is a one-to-one relation
  sessions           Session[] // This is a one-to-many relation (important!)
  verificationTokens VerificationToken[] // This is a one-to-many relation
  roleChangesReceived RoleChange[]       @relation("RoleChangeTarget")
  roleChangesMade     RoleChange[]       @relation("RoleChangeActor")
  orderNotes          OrderNote[]
  activity            ActivityLog[]
}

// One row each time an admin makes or removes another admin. The emails and
// names are copied in, so the history still reads correctly after someone is
// renamed or deleted (targetId / actorId then become null).
model RoleChange {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  fromRole    String
  toRole      String
  targetEmail String
  targetName  String?
  actorEmail  String
  actorName   String?
  target      User?    @relation("RoleChangeTarget", fields: [targetId], references: [id], onDelete: SetNull)
  targetId    String?
  actor       User?    @relation("RoleChangeActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?

  @@index([createdAt])
}

model VerificationToken {
  id        String   @id @default(cuid())
  token     String   @unique
  type      String // e.g. "EMAIL_VERIFY"
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  newEmail  String? // for EMAIL_CHANGE tokens: the address the account is asking to change to
}

model Session {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // This is a one-to-one relation
  userId    String // This is a foreign key
}

model Profile {
  id        String   @id @default(cuid())
  name      String?
  address1  String?
  address2  String?
  city      String?
  state     String?
  zip       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade) // This is a one-to-one relation
  userId    String   @unique // This is a foreign key
  Cart      Cart? // This is a one-to-one relation
  orders    Order[] // This is a one-to-many relation
}

model Order {
  id                   String          @id @default(cuid())
  productTotalInCents  Int
  shippingTotalInCents Int?
  taxTotalInCents      Int?
  totalInCents         Int
  trackingNumber       String?
  fulfilled            Boolean         @default(false)
  stripePaymentIntentId String?        @unique
  refundedAt           DateTime? // set once the order is fully refunded
  refundedAmountInCents Int?
  stripeRefundId       String? // null on a refunded order means it was marked refunded manually
  shipToName           String? // the shipping address as it was at checkout; null on orders placed before this was saved
  shipToAddress1       String?
  shipToAddress2       String?
  shipToCity           String?
  shipToState          String?
  shipToZip            String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  profile              Profile         @relation(fields: [profileId], references: [id], onDelete: Restrict) // This is a many-to-one relation
  profileId            String
  discountInCents      Int             @default(0) // taken off the items total by a discount code
  discountCode         String? // the code used, as text (no relation, so deleting a code never touches order history)
  Order_Products       Order_Product[] // This is a many-to-many relation
  notes                OrderNote[]
}

model Cart {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade) // This is a one-to-one relation
  profileId     String         @unique
  discountCode  String? // the code the customer has applied, cleared once the order is placed
  Cart_Products Cart_Product[] // This is a many-to-many relation
}

model Product {
  id              String          @id @default(cuid())
  name            String
  priceInCents    Int
  description     String
  quantity        Int?
  isAvailable     Boolean         @default(true)
  isFeatured      Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict) // This is a one-to-many relation
  categoryId      String          @map("catagoryId")
  Orders_Products Order_Product[] // This is a many-to-many relation
  Cart_Products   Cart_Product[] // This is a many-to-many relation
  images          ProductImage[] // Position 0 is the cover image
  variants        ProductVariant[] // optional named options (size, colour...), each with its own stock
}

// One choosable option of a product. A product with no rows here is sold as a
// single item; with rows, a shopper must pick one.
model ProductVariant {
  id           String   @id @default(cuid())
  name         String
  priceInCents Int? // null = use the product's price
  quantity     Int
  position     Int
  createdAt    DateTime @default(now())
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId    String

  @@index([productId, position])
}

// The cart as it was when checkout began, kept until the order exists. Stripe
// only allows 500 characters of metadata, which is too little for a real cart.
model CheckoutSnapshot {
  id              String   @id @default(cuid())
  paymentIntentId String   @unique
  userId          String
  cartId          String
  itemsJson       String
  createdAt       DateTime @default(now())

  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(cuid())
  path      String
  position  Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String

  @@index([productId, position])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0) // position on the storefront: lowest first
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[] // This is a many-to-one relation

  @@map("Category")
}

model Order_Product {
  order_id     String
  product_id   String
  variant_id   String  @default("") // "" = the product has no options
  variantName  String  @default("") // the option's name when it was bought
  Order        Order   @relation(fields: [order_id], references: [id], onDelete: Restrict)
  Product      Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity     Int
  priceInCents Int     @default(0)

  @@id([order_id, product_id, variant_id])
  @@map("Orders_Product")
}

model Cart_Product {
  cart_id    String
  product_id String
  variant_id String  @default("") // "" = the product has no options
  Cart       Cart    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  Product    Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  quantity   Int

  @@id([cart_id, product_id, variant_id])
  @@map("Cart_Products")
}

model DiscountCode {
  id              String   @id @default(cuid())
  code            String   @unique // stored uppercase; matched ignoring case; never renamed
  kind            String // PERCENT | FIXED | FREE_SHIPPING
  value           Int // percent (1-100) or cents; 0 for FREE_SHIPPING
  oncePerCustomer Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// One row at most (id "shop"); with no row the shop uses the defaults in src/lib/pricing.ts
model ShippingSettings {
  id               String   @id
  flatRateInCents  Int
  freeOverInCents  Int? // null = shipping is never free by total
  updatedAt        DateTime @updatedAt
}

// An admin-only note on an order. The author's email and name are copied in so
// the note still reads correctly if the account changes.
model OrderNote {
  id          String   @id @default(cuid())
  body        String
  createdAt   DateTime @default(now())
  authorEmail String
  authorName  String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId    String?
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String

  @@index([orderId])
}

// One line for each change an admin makes. `summary` is a finished sentence, so
// an entry still reads correctly after the thing it mentions is renamed or deleted.
model ActivityLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorEmail String
  actorName  String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  area       String // ORDER | PRODUCT | CATEGORY | PRICING | CUSTOMER
  summary    String
  orderId    String? // set when the entry is about one order

  @@index([createdAt])
  @@index([orderId])
}

// One row for each password guess that went wrong (or that was let through and
// is still being decided), used to slow guessing down. `subject` is the lower-cased
// email for sign-in, or the user id for the "current password" box on the Account
// page. Old rows are deleted after a day; no password is ever stored here.
model AuthAttempt {
  id        String   @id @default(cuid())
  kind      String // SIGN_IN | CHANGE_PASSWORD | SIGN_IN_NOTICE (owner emailed about a block)
  subject   String
  ip        String   @default("") // "" when the address isn't known
  createdAt DateTime @default(now())

  @@index([kind, subject, createdAt])
  @@index([kind, ip, createdAt])
}

# Copy this file to .env and fill in real values. Never commit .env.

# Only for Server
DATABASE_URL="file:./dev.db"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RESEND_API_KEY=""
EMAIL_FROM="Dragon's Bounty <orders@yourdomain.com>"

# Image storage (Cloudflare R2, S3-compatible) — also put these in .env.local, never commit real values
# NEXT_AWS_S3_REGION="auto"
# NEXT_AWS_S3_BUCKET=""
# NEXT_AWS_S3_ACCESS_KEY_ID=""
# NEXT_AWS_S3_SECRET_ACCESS_KEY=""
# NEXT_AWS_S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"

# Only for Client
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=""
NEXT_PUBLIC_SERVER_URL="http://localhost:3000"
NEXT_PUBLIC_S3_BASE_URL="https://pub-xxxxxxxx.r2.dev/"
